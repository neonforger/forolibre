<?xml version="1.0" encoding="utf-8"?>
<!-- Buscador. OJO con los colores fijos del EditText: el tema es DayNight y el panel tiene
     fondo blanco, así que sin textColor/textColorHint explícitos el campo es invisible en
     modo oscuro (mismo patrón que login_user y sheet_thread_pages). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#C8102E"
        android:letterSpacing="0.03"
        android:text="BUSCAR EN FOROCOCHES" />

    <EditText
        android:id="@+id/search_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:maxLines="1"
        android:textSize="16sp"
        android:hint="Palabras a buscar"
        android:textColor="#212121"
        android:textColorHint="#9E9E9E"
        android:importantForAutofill="no" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/search_titles_only"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Buscar solo en los títulos"
        android:textSize="15sp"
        android:textColor="#212121" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textColor="#9E9E9E"
        android:text="Desactívalo para buscar también dentro de los mensajes." />

    <TextView
        android:id="@+id/search_go"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:gravity="center"
        android:text="Buscar"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#C8102E" />

</LinearLayout>
