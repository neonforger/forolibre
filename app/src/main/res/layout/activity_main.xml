<?xml version="1.0" encoding="utf-8"?>
<!-- v2-shell: capa nativa (lista de hilos + barra inferior) sobre el WebView clásico.
     El WebView sigue siendo el motor de datos y la vista de hilo; se alternan por
     visibilidad. Los ids swipe_refresh/webview se conservan del layout original. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Capa nativa -->
        <LinearLayout
            android:id="@+id/native_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF">

                <TextView
                    android:id="@+id/native_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp"
                    android:text="ForoPlus"
                    android:textColor="#C8102E"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/native_options"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="⚙"
                    android:textSize="20sp"
                    android:textColor="#616161"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Opciones" />
            </LinearLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/forum_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:elevation="2dp"
                app:tabMode="scrollable"
                app:tabIndicatorColor="#C8102E"
                app:tabSelectedTextColor="#C8102E"
                app:tabTextColor="#757575" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/list_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/thread_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false" />
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

                <ProgressBar
                    android:id="@+id/list_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/list_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:padding="24dp"
                    android:gravity="center"
                    android:textColor="#757575"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- Crear hilo nuevo en el subforo actual (Bloque crear/editar/borrar). -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fab_new_thread"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="18dp"
                    android:src="@drawable/ic_add"
                    android:contentDescription="Crear hilo nuevo"
                    app:backgroundTint="#C8102E"
                    app:tint="#FFFFFF"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Capa hilo nativo (Fase 2) -->
        <LinearLayout
            android:id="@+id/thread_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:paddingStart="14dp"
                android:paddingEnd="6dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/thread_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/thread_page_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="#9E9E9E" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/thread_reply"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_reply"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Responder" />

                <ImageButton
                    android:id="@+id/thread_open_web"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_open_web"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Abrir en la web" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/post_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false" />

                <ProgressBar
                    android:id="@+id/thread_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <!-- Hilo restringido (+HD): misma info que da FC, con nuestros estilos. -->
                <LinearLayout
                    android:id="@+id/thread_restricted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒"
                        android:textSize="34sp" />

                    <TextView
                        android:id="@+id/restricted_msg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A" />

                    <TextView
                        android:id="@+id/restricted_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="#9E9E9E" />

                    <TextView
                        android:id="@+id/restricted_login"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:gravity="center"
                        android:text="Iniciar sesión"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#C8102E" />

                    <TextView
                        android:id="@+id/restricted_invite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Cómo conseguir una invitación"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#C8102E"
                        android:background="?attr/selectableItemBackground" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

        <!-- Capa RESPUESTA nativa (Fase 3): pantalla completa propia, tipo "pestaña de
             respuesta". Citas arriba como tarjetas quitables + caja grande. El envío usa
             fcSubmitReply, que reutiliza el securitytoken del form real de FC. -->
        <LinearLayout
            android:id="@+id/reply_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:paddingStart="6dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/reply_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="✕"
                    android:textSize="18sp"
                    android:textColor="#616161"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Cancelar" />

                <TextView
                    android:id="@+id/reply_header_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Responder"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A" />

                <TextView
                    android:id="@+id/reply_send"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="Enviar"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#C8102E"
                    android:background="?attr/selectableItemBackground" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/reply_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp">

                    <!-- Asunto: solo visible al crear hilo nuevo. -->
                    <EditText
                        android:id="@+id/reply_subject"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:background="#F3F3F3"
                        android:padding="12dp"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:hint="Título del hilo"
                        android:textColorHint="#9E9E9E"
                        android:inputType="text|textCapSentences"
                        android:maxLines="2"
                        android:importantForAutofill="no"
                        android:visibility="gone" />

                    <!-- Tarjetas de cita (una por post citado), añadidas por código. -->
                    <LinearLayout
                        android:id="@+id/reply_quotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <EditText
                        android:id="@+id/reply_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minHeight="140dp"
                        android:background="@null"
                        android:gravity="top"
                        android:textSize="15sp"
                        android:textColor="#212121"
                        android:hint="Escribe tu respuesta…"
                        android:textColorHint="#9E9E9E"
                        android:inputType="textMultiLine|textCapSentences"
                        android:importantForAutofill="no" />
                </LinearLayout>
            </ScrollView>

            <!-- Barra de formato BBCode (Bloque A): siempre visible encima del teclado. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F5F5F5"
                android:elevation="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/fmt_bold"
                        style="@style/FmtButton"
                        android:text="B"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/fmt_italic"
                        style="@style/FmtButton"
                        android:text="I"
                        android:textStyle="italic" />

                    <TextView
                        android:id="@+id/fmt_under"
                        style="@style/FmtButton"
                        android:text="U" />

                    <TextView
                        android:id="@+id/fmt_color"
                        style="@style/FmtButton"
                        android:text="A"
                        android:textColor="#C8102E"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/fmt_size"
                        style="@style/FmtButton"
                        android:text="Tt" />

                    <TextView
                        android:id="@+id/fmt_align"
                        style="@style/FmtButton"
                        android:text="≡" />

                    <TextView
                        android:id="@+id/fmt_list"
                        style="@style/FmtButton"
                        android:text="•‒" />

                    <TextView
                        android:id="@+id/fmt_img"
                        style="@style/FmtButton"
                        android:text="🖼" />

                    <TextView
                        android:id="@+id/fmt_url"
                        style="@style/FmtButton"
                        android:text="🔗" />

                    <TextView
                        android:id="@+id/fmt_embed"
                        style="@style/FmtButton"
                        android:text="▶" />

                    <TextView
                        android:id="@+id/fmt_quote"
                        style="@style/FmtButton"
                        android:text="❝" />

                    <TextView
                        android:id="@+id/fmt_spoiler"
                        style="@style/FmtButton"
                        android:text="▓" />

                    <TextView
                        android:id="@+id/fmt_smiley"
                        style="@style/FmtButton"
                        android:text="🙂" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Capa CITAS/MENCIONES nativa (Bloque B): aisladas, no el batiburrillo de FC. -->
        <LinearLayout
            android:id="@+id/notices_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:visibility="gone">

            <TextView
                android:id="@+id/notices_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="10dp"
                android:textColor="#C8102E"
                android:textSize="20sp"
                android:textStyle="bold"
                android:elevation="2dp"
                android:background="#FFFFFF" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/notices_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false" />

                <ProgressBar
                    android:id="@+id/notices_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/notices_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:padding="24dp"
                    android:gravity="center"
                    android:textColor="#757575"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Capa PERFIL nativa (Bloque B): datos básicos + cerrar sesión. -->
        <LinearLayout
            android:id="@+id/profile_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#FFFFFF"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/profile_avatar"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginTop="56dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A" />

            <TextView
                android:id="@+id/profile_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cuenta de ForoCoches"
                android:textSize="13sp"
                android:textColor="#9E9E9E" />

            <TextView
                android:id="@+id/profile_open_web"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center"
                android:text="Ver perfil completo (navegador)"
                android:textSize="14sp"
                android:textColor="#616161"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/profile_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:gravity="center"
                android:text="Cerrar sesión"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#C8102E" />
        </LinearLayout>

        <!-- Capa OPCIONES nativa: fuente, avatar, filtros de palabras y usuarios ignorados. -->
        <LinearLayout
            android:id="@+id/options_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:paddingStart="6dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/options_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="←"
                    android:textSize="20sp"
                    android:textColor="#616161"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Volver" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Opciones"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="24dp">

                    <!-- Fuente -->
                    <TextView style="@style/OptSection" android:text="Tamaño de fuente" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <TextView android:id="@+id/opt_font_small" style="@style/OptChip" android:text="Pequeña" />
                        <TextView android:id="@+id/opt_font_normal" style="@style/OptChip" android:text="Normal" />
                        <TextView android:id="@+id/opt_font_large" style="@style/OptChip" android:text="Grande" />
                    </LinearLayout>

                    <!-- Cuenta -->
                    <TextView style="@style/OptSection" android:text="Cuenta" />

                    <TextView
                        android:id="@+id/opt_avatar"
                        style="@style/OptRow"
                        android:text="Cambiar avatar" />

                    <TextView
                        android:id="@+id/opt_edit_profile"
                        style="@style/OptRow"
                        android:text="Editar perfil" />

                    <!-- Filtro de palabras -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="22dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Filtro de palabras"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#C8102E"
                            android:letterSpacing="0.03" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/opt_kw_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Oculta hilos cuyo título contenga estas palabras."
                        android:textSize="12sp"
                        android:textColor="#9E9E9E" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <EditText
                            android:id="@+id/opt_kw_input"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Añadir palabra"
                            android:textColorHint="#9E9E9E"
                            android:textSize="14sp"
                            android:textColor="#212121"
                            android:inputType="text"
                            android:maxLines="1"
                            android:importantForAutofill="no" />

                        <TextView
                            android:id="@+id/opt_kw_add"
                            style="@style/OptAddBtn"
                            android:text="Añadir" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/opt_kw_chips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="6dp" />

                    <!-- Usuarios ignorados -->
                    <TextView style="@style/OptSection" android:text="Usuarios ignorados" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Oculta los mensajes e hilos de estos usuarios."
                        android:textSize="12sp"
                        android:textColor="#9E9E9E" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <EditText
                            android:id="@+id/opt_ig_input"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Nombre de usuario"
                            android:textColorHint="#9E9E9E"
                            android:textSize="14sp"
                            android:textColor="#212121"
                            android:inputType="text"
                            android:maxLines="1"
                            android:importantForAutofill="no" />

                        <TextView
                            android:id="@+id/opt_ig_add"
                            style="@style/OptAddBtn"
                            android:text="Añadir" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/opt_ig_chips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- Capa LOGIN nativa (Fase 3): formulario propio. Las credenciales las envía
             fcLogin por el form real de FC (same-origin, cookies del WebView), pero el
             usuario nunca ve el foro por debajo. -->
        <ScrollView
            android:id="@+id/login_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="48dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ForoPlus"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#C8102E" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Inicia sesión con tu cuenta de ForoCoches"
                    android:textSize="14sp"
                    android:textColor="#616161" />

                <EditText
                    android:id="@+id/login_user"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:hint="Usuario"
                    android:textColorHint="#9E9E9E"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:inputType="text"
                    android:maxLines="1"
                    android:importantForAutofill="no" />

                <EditText
                    android:id="@+id/login_pass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Contraseña"
                    android:textColorHint="#9E9E9E"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:importantForAutofill="no" />

                <TextView
                    android:id="@+id/login_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="13sp"
                    android:textColor="#C8102E"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/login_submit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp"
                    android:gravity="center"
                    android:text="Iniciar sesión"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#C8102E" />

                <TextView
                    android:id="@+id/login_skip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:gravity="center"
                    android:text="Seguir sin cuenta"
                    android:textSize="14sp"
                    android:textColor="#616161"
                    android:background="?attr/selectableItemBackground" />

                <TextView
                    android:id="@+id/login_register"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:gravity="center"
                    android:text="¿No tienes cuenta? Regístrate"
                    android:textSize="13sp"
                    android:textColor="#9E9E9E"
                    android:background="?attr/selectableItemBackground" />
            </LinearLayout>
        </ScrollView>

        <!-- Capa web (la app clásica, también motor de datos cuando está oculta) -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible">

            <WebView
                android:id="@+id/webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </FrameLayout>

    <!-- Barra inferior propia: 6 destinos con scroll lateral (Material limita a 5). -->
    <HorizontalScrollView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <include
                android:id="@+id/nav_home"
                layout="@layout/nav_item"
                android:layout_width="76dp"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/nav_favs"
                layout="@layout/nav_item"
                android:layout_width="76dp"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/nav_mythreads"
                layout="@layout/nav_item"
                android:layout_width="76dp"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/nav_participated"
                layout="@layout/nav_item"
                android:layout_width="76dp"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/nav_notif"
                layout="@layout/nav_item"
                android:layout_width="76dp"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/nav_quotes"
                layout="@layout/nav_item"
                android:layout_width="76dp"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/nav_profile"
                layout="@layout/nav_item"
                android:layout_width="76dp"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
