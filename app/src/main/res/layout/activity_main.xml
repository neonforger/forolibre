<?xml version="1.0" encoding="utf-8"?>
<!-- v2-shell: capa nativa (lista de hilos + barra inferior) sobre el WebView clásico.
     El WebView sigue siendo el motor de datos y la vista de hilo; se alternan por
     visibilidad. Los ids swipe_refresh/webview se conservan del layout original. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Capa nativa -->
        <LinearLayout
            android:id="@+id/native_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/native_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:text="ForoPlus"
                android:textColor="#C8102E"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="#FFFFFF" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/forum_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:elevation="2dp"
                app:tabMode="scrollable"
                app:tabIndicatorColor="#C8102E"
                app:tabSelectedTextColor="#C8102E"
                app:tabTextColor="#757575" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/list_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/thread_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false" />
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

                <ProgressBar
                    android:id="@+id/list_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/list_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:padding="24dp"
                    android:gravity="center"
                    android:textColor="#757575"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Capa hilo nativo (Fase 2) -->
        <LinearLayout
            android:id="@+id/thread_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:paddingStart="14dp"
                android:paddingEnd="6dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/thread_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/thread_page_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="#9E9E9E" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/thread_reply"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_reply"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Responder" />

                <ImageButton
                    android:id="@+id/thread_open_web"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_open_web"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Abrir en la web" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/post_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false" />

                <ProgressBar
                    android:id="@+id/thread_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <!-- Hilo restringido (+HD): misma info que da FC, con nuestros estilos. -->
                <LinearLayout
                    android:id="@+id/thread_restricted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒"
                        android:textSize="34sp" />

                    <TextView
                        android:id="@+id/restricted_msg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A" />

                    <TextView
                        android:id="@+id/restricted_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="#9E9E9E" />

                    <TextView
                        android:id="@+id/restricted_login"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:gravity="center"
                        android:text="Iniciar sesión"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#C8102E" />

                    <TextView
                        android:id="@+id/restricted_invite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Cómo conseguir una invitación"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#C8102E"
                        android:background="?attr/selectableItemBackground" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

        <!-- Capa RESPUESTA nativa (Fase 3): pantalla completa propia, tipo "pestaña de
             respuesta". Citas arriba como tarjetas quitables + caja grande. El envío usa
             fcSubmitReply, que reutiliza el securitytoken del form real de FC. -->
        <LinearLayout
            android:id="@+id/reply_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:paddingStart="6dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/reply_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="✕"
                    android:textSize="18sp"
                    android:textColor="#616161"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Cancelar" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Responder"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A" />

                <TextView
                    android:id="@+id/reply_send"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="Enviar"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#C8102E"
                    android:background="?attr/selectableItemBackground" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/reply_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp">

                    <!-- Tarjetas de cita (una por post citado), añadidas por código. -->
                    <LinearLayout
                        android:id="@+id/reply_quotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <EditText
                        android:id="@+id/reply_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minHeight="140dp"
                        android:background="@null"
                        android:gravity="top"
                        android:textSize="15sp"
                        android:textColor="#212121"
                        android:hint="Escribe tu respuesta…"
                        android:textColorHint="#9E9E9E"
                        android:inputType="textMultiLine|textCapSentences"
                        android:importantForAutofill="no" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- Capa LOGIN nativa (Fase 3): formulario propio. Las credenciales las envía
             fcLogin por el form real de FC (same-origin, cookies del WebView), pero el
             usuario nunca ve el foro por debajo. -->
        <ScrollView
            android:id="@+id/login_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="48dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ForoPlus"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#C8102E" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Inicia sesión con tu cuenta de ForoCoches"
                    android:textSize="14sp"
                    android:textColor="#616161" />

                <EditText
                    android:id="@+id/login_user"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:hint="Usuario"
                    android:textColorHint="#9E9E9E"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:inputType="text"
                    android:maxLines="1"
                    android:importantForAutofill="no" />

                <EditText
                    android:id="@+id/login_pass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Contraseña"
                    android:textColorHint="#9E9E9E"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:importantForAutofill="no" />

                <TextView
                    android:id="@+id/login_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="13sp"
                    android:textColor="#C8102E"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/login_submit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp"
                    android:gravity="center"
                    android:text="Iniciar sesión"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#C8102E" />

                <TextView
                    android:id="@+id/login_skip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:gravity="center"
                    android:text="Seguir sin cuenta"
                    android:textSize="14sp"
                    android:textColor="#616161"
                    android:background="?attr/selectableItemBackground" />

                <TextView
                    android:id="@+id/login_register"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:gravity="center"
                    android:text="¿No tienes cuenta? Regístrate"
                    android:textSize="13sp"
                    android:textColor="#9E9E9E"
                    android:background="?attr/selectableItemBackground" />
            </LinearLayout>
        </ScrollView>

        <!-- Capa web (la app clásica, también motor de datos cuando está oculta) -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible">

            <WebView
                android:id="@+id/webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="@color/bottom_nav_tint"
        app:itemTextColor="@color/bottom_nav_tint"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />

</LinearLayout>
