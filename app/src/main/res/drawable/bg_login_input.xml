<?xml version="1.0" encoding="utf-8"?>
<!-- Campo del login sobre fondo oscuro: se enciende en coral al tener el foco. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#241C1D" />
            <stroke android:width="2dp" android:color="#FD5D4D" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1516" />
            <stroke android:width="1dp" android:color="#3A2F31" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
